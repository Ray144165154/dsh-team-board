{
  "name": "@local/dsh-team-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "协作台：多 agent 协作协议看板，含待拍板卡与 agent 读写工具",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
